@{ ViewBag.Title = "Đăng nhập"; }
<div class="card p-4 mx-auto" style="max-width:450px">
<h2>Đăng nhập</h2>
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@using (Html.BeginForm()) {
 @Html.AntiForgeryToken()
 <div class="form-group mb-3"><label>Tên đăng nhập</label><input name="username" class="form-control" required /></div>
 <div class="form-group mb-3"><label>Mật khẩu</label><input name="password" type="password" class="form-control" required /></div>
 <button class="btn btn-primary btn-block">Đăng nhập</button>
}
<p class="mt-3">Chưa có tài khoản? @Html.ActionLink("Đăng ký", "Index", "Signup")</p>
</div>