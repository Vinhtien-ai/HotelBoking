<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - HotelBoking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
 <div class="container">
  @Html.ActionLink("HotelBoking", "Index", "Home", null, new { @class = "navbar-brand" })
  <div class="navbar-nav">
   @Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "nav-link" })
   @Html.ActionLink("Phòng", "Index", "Room", null, new { @class = "nav-link" })
   @if (Session["PersonId"] != null) {
    @Html.ActionLink("Đặt phòng của tôi", "History", "Booking", null, new { @class = "nav-link" })
   }
   @if (Session["LoaiTaiKhoan"] != null && (int)Session["LoaiTaiKhoan"] == 2) {
    @Html.ActionLink("Quản trị", "Index", "Admin", null, new { @class = "nav-link" })
   }
  </div>
  <div class="navbar-nav ms-auto">
   @if (Session["UserName"] == null) {
    @Html.ActionLink("Đăng nhập", "Index", "Login", null, new { @class = "nav-link" })
    @Html.ActionLink("Đăng ký", "Index", "Signup", null, new { @class = "nav-link" })
   } else {
    <span class="navbar-text text-white mr-3">@Session["UserName"]</span>
    @Html.ActionLink("Đăng xuất", "Logout", "Login", null, new { @class = "nav-link" })
   }
  </div>
 </div>
</nav>
<main class="container py-4">@RenderBody()</main>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>